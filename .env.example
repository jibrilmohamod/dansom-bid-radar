# Supabase project (Project settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Shared key checked by the database functions (stored in public.app_secret)
BID_RADAR_APP_KEY=

# Password for the site login, and a random string used to sign the session cookie
SITE_PASSWORD=
SESSION_SECRET=

# Vercel Cron sends this as a Bearer token to /api/ingest
CRON_SECRET=

# Approved ReliefWeb API app name (request one at https://apidoc.reliefweb.int)
RELIEFWEB_APPNAME=
